# 🔒 Variables d'environnement - RevisAI Backend

# 🗄️ PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/revisai_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=revisai_db

# 🚀 Serveur
PORT=5000
NODE_ENV=development

# 🔐 Sécurité JWT
JWT_SECRET=votre_super_secret_jwt_changez_moi_en_production_123456789

# 🤖 Hugging Face API
HUGGINGFACE_API_KEY=votre_cle_api_huggingface

# 🌐 CORS
CORS_ORIGIN=http://localhost:5173
